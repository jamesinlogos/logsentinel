        },
        "sampling": 1,
        "ignore_global_filters": false,
        "metrics": [
          {
            "operation": "count",
            "label": "Documents",
            "empty_as_null": false
          }
        ],
        "group_by": [
          {
            "operation": "filters",
            "filters": [
              {
                "label": "Process creation (1)",
                "filter": {
                  "language": "kql",
                  "expression": "event.code: \"1\""
                }
              },
              {
                "label": "File creation (11)",
                "filter": {
                  "language": "kql",
                  "expression": "event.code: \"11\""
                }
              },
              {
                "label": "File deletion (26)",
                "filter": {
                  "language": "kql",
                  "expression": "event.code: \"26\""
                }
              },
              {
                "label": "Registry (12/13/14)",
                "filter": {
                  "language": "kql",
                  "expression": "event.code: (\"12\" or \"13\" or \"14\")"
                }
              },
              {
                "label": "Network connections (3)",
                "filter": {
                  "language": "kql",
                  "expression": "event.code: \"3\""
                }
              },
              {
                "label": "Other events",
                "filter": {
                  "language": "kql",
                  "expression": "NOT event.code: (\"1\" or \"3\" or \"11\" or \"12\" or \"13\" or \"14\" or \"26\")"
                }
              }
            ],
            "color": {
