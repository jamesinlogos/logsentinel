      "id": "ae7f7315-2ba2-5f84-b6c4-de5eef79ba3d",
      "type": "vis",
      "grid": {
        "x": 36,
        "y": 6,
        "w": 12,
        "h": 5
      },
      "config": {
        "type": "metric",
        "title": "Phase 2 gate pass rate",
        "data_source": {
          "type": "data_view_spec",
          "index_pattern": "ransomware-window-scores-*",
          "time_field": "@timestamp"
        },
        "sampling": 1,
        "ignore_global_filters": false,
        "metrics": [
          {
            "type": "primary",
            "operation": "formula",
            "formula": "count(kql='logsentinel.verdict.gated: true') / count()",
            "label": "Gated / all windows",
            "format": {
              "type": "percent",
              "decimals": 1,
              "compact": false
            },
            "color": {
              "type": "auto"
            }
          }
        ],
        "styling": {
          "density": "default"
        }
      }
