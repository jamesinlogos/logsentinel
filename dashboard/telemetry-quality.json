    {
      "id": "a74027d6-7959-5dea-9912-03b3e74681be",
      "type": "vis",
      "grid": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 16
      },
      "config": {
        "type": "xy",
        "title": "Window-score contract exceptions | overlapping checks",
        "layers": [
          {
            "type": "bar_horizontal",
            "data_source": {
              "type": "data_view_spec",
              "index_pattern": "ransomware-window-scores-*",
              "time_field": "@timestamp"
            },
            "sampling": 1,
            "ignore_global_filters": false,
            "x": {
              "operation": "filters",
              "filters": [
                {
                  "label": "Reported without gate",
                  "filter": {
                    "language": "kql",
                    "expression": "logsentinel.verdict.reported: true and NOT logsentinel.verdict.gated: true"
                  }
                },
                {
                  "label": "Ungated marked suspicious",
                  "filter": {
                    "language": "kql",
                    "expression": "logsentinel.verdict.gated: false and logsentinel.verdict.suspicious: true"
                  }
                },
                {
                  "label": "Missing verdict flags",
                  "filter": {
                    "language": "kql",
                    "expression": "NOT logsentinel.verdict.gated: * or NOT logsentinel.verdict.reported: * or NOT logsentinel.verdict.suspicious: *"
                  }
                },
                {
                  "label": "Missing window ID",
                  "filter": {
                    "language": "kql",
                    "expression": "NOT logsentinel.window.id: *"
                  }
                },
                {
                  "label": "Missing host ID",
                  "filter": {
                    "language": "kql",
                    "expression": "NOT host.id: *"
                  }
                },
                {
                  "label": "Missing schema version",
                  "filter": {
                    "language": "kql",
                    "expression": "NOT logsentinel.schema_version: *"
                  }
                },
                {
                  "label": "Gated without confidence",
                  "filter": {
                    "language": "kql",
                    "expression": "logsentinel.verdict.gated: true and NOT logsentinel.verdict.confidence_score: *"
                  }
                },
                {
                  "label": "Gated without label",
                  "filter": {
                    "language": "kql",
                    "expression": "logsentinel.verdict.gated: true and NOT logsentinel.verdict.label: *"
                  }
                }
              ]
            },
            "y": [
              {
                "operation": "count",
                "label": "Window scores matching condition",
                "empty_as_null": false
              }
            ]
          }
        ],
        "query": {
          "language": "kql",
          "expression": ""
        },
        "styling": {
          "bars": {
            "data_labels": {
              "visible": true
            }
          }
        },
        "axis": {
          "x": {
            "title": {
              "visible": true
            },
            "labels": {
              "orientation": "horizontal"
            }
          },
          "y": {
            "title": {
              "visible": true
            },
            "scale": "linear"
          }
        },
        "legend": {
          "placement": "outside",
          "position": "bottom",
          "layout": {
            "type": "list"
          },
          "visibility": "hidden"
        }
      }
