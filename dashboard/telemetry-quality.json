    {
      "id": "33168d3c-737f-5e50-8f10-9feaa5de1ebf",
      "type": "vis",
      "grid": {
        "x": 0,
        "y": 53,
        "w": 24,
        "h": 16
      },
      "config": {
        "type": "xy",
        "title": "Telemetry field coverage | overlapping exception checks",
        "layers": [
          {
            "type": "bar_horizontal",
            "data_source": {
              "type": "data_view_spec",
              "index_pattern": "windows-telemetry-*",
              "time_field": "@timestamp"
            },
            "sampling": 1,
            "ignore_global_filters": false,
            "x": {
              "operation": "filters",
              "filters": [
                {
                  "label": "Missing timestamp",
                  "filter": {
                    "language": "kql",
                    "expression": "NOT @timestamp: *"
                  }
                },
                {
                  "label": "Missing host name",
                  "filter": {
                    "language": "kql",
                    "expression": "NOT host.name: *"
                  }
                },
                {
                  "label": "Missing event code",
                  "filter": {
                    "language": "kql",
                    "expression": "NOT event.code: *"
                  }
                },
                {
                  "label": "Process start without executable",
                  "filter": {
                    "language": "kql",
                    "expression": "event.code: \"1\" and NOT process.executable: *"
                  }
                },
                {
                  "label": "File creation without path",
                  "filter": {
                    "language": "kql",
                    "expression": "event.code: \"11\" and NOT file.path: *"
                  }
                },
                {
                  "label": "Network event without destination IP",
                  "filter": {
                    "language": "kql",
                    "expression": "event.code: \"3\" and NOT destination.ip: *"
                  }
                },
                {
                  "label": "Registry change without path",
                  "filter": {
                    "language": "kql",
