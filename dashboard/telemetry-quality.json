      "id": "123a375c-9217-5ee8-9173-c4c9ab385994",
      "type": "discover_session",
      "grid": {
        "x": 0,
        "y": 87,
        "w": 48,
        "h": 18
      },
      "config": {
        "title": "Window-score exceptions | inspect schema and source document",
        "tabs": [
          {
            "data_source": {
              "type": "data_view_spec",
              "index_pattern": "ransomware-window-scores-*",
              "time_field": "@timestamp"
            },
            "query": {
              "language": "kql",
              "expression": "(logsentinel.verdict.reported: true and NOT logsentinel.verdict.gated: true) or (logsentinel.verdict.gated: false and logsentinel.verdict.suspicious: true) or (NOT logsentinel.verdict.gated: * or NOT logsentinel.verdict.reported: * or NOT logsentinel.verdict.suspicious: *) or (NOT logsentinel.window.id: *) or (NOT host.id: *) or (NOT logsentinel.schema_version: *) or (logsentinel.verdict.gated: true and NOT logsentinel.verdict.confidence_score: *) or (logsentinel.verdict.gated: true and NOT logsentinel.verdict.label: *)"
            },
            "column_order": [
              "@timestamp",
              "host.name",
              "host.id",
              "logsentinel.schema_version",
              "logsentinel.window.id",
              "logsentinel.verdict.gated",
              "logsentinel.verdict.suspicious",
              "logsentinel.verdict.reported",
              "logsentinel.verdict.confidence_score",
              "logsentinel.verdict.label",
              "logsentinel.model.version"
            ],
            "sort": [
              {
                "name": "@timestamp",
                "direction": "desc"
              }
            ],
            "rows_per_page": 25,
            "view_mode": "documents"
          }
        ]
      }
    }
