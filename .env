# LogSentinel stack configuration, read by docker compose (docker-compose.yml) and by
# scripts/*.sh. Every variable of the stack starts with LOGSENTINEL_ (AGENTS.md section 11.5);
# the services take their own settings from INFERENCE__<SECTION>__<KEY>.

# ---- Image versions ----
LOGSENTINEL_KAFKA_IMAGE_TAG=4.3.1
LOGSENTINEL_ELASTIC_STACK_VERSION=9.5.3

# ---- Elasticsearch ----
LOGSENTINEL_ES_JAVA_OPTS=-Xms1g -Xmx1g
LOGSENTINEL_ES_PORT=9200

# ---- Kibana ----
LOGSENTINEL_KIBANA_PORT=5601

# ---- Kafka ----
LOGSENTINEL_KAFKA_ADVERTISED_HOST=192.168.110.1
LOGSENTINEL_KAFKA_PORT=9092
LOGSENTINEL_KAFKA_NODE_ID=1

# ---- Kafka topic names (see README.md section 6) ----
LOGSENTINEL_TOPIC_RAW_TELEMETRY=telemetry.windows.sysmon.raw
LOGSENTINEL_TOPIC_NORMALIZED_TELEMETRY=telemetry.windows.normalized
LOGSENTINEL_TOPIC_DETECTIONS=security.ransomware.detections
LOGSENTINEL_TOPIC_WINDOW_SCORES=security.ransomware.window-scores

# ---- Logs (optional) ----
# inference log level: DEBUG traces every scored window, INFO is the default.
# LOGSENTINEL_LOG_LEVEL=INFO

# Credentials: the Kibana key below and the Telegram/Gmail values are blank in the committed file. After
# filling them in run `git update-index --skip-worktree .env`, so that git never stages them (AGENTS.md section 8).
# Kibana alerting needs a permanent saved-object encryption key (at least 32 characters). Keep it
# private and unchanged across redeploys: rules and connectors saved with it cannot be read with another.
LOGSENTINEL_KIBANA_ENCRYPTION_KEY=

# notifications worker (Telegram and Gmail, notifications/README.md): fill in locally; never paste the
# values into documents or logs.
LOGSENTINEL_TELEGRAM_BOT_TOKEN=
LOGSENTINEL_TELEGRAM_CHAT_ID=
LOGSENTINEL_GMAIL_SENDER=
LOGSENTINEL_GMAIL_APP_PASSWORD=
LOGSENTINEL_EMAIL_RECIPIENTS=
LOGSENTINEL_NOTIFICATIONS_POLL_SEC=30
LOGSENTINEL_NOTIFICATIONS_TIMEOUT_SEC=15
